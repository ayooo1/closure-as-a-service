# ---- API (apps/api) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1 minute
CACHE_TTL_SECONDS=3600

# ---- Web (apps/web) ----
# Where the Next.js server proxies /api/* (local dev & docker-compose).
# In Kubernetes the Ingress routes /api directly to the API service instead.
API_INTERNAL_URL=http://localhost:4000
