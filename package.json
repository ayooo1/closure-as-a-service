{
  "name": "closure-as-a-service",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered breakup message generator — Next.js + Fastify + Redis on Kubernetes",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@caas/api & npm run dev --workspace=@caas/web",
    "dev:web": "npm run dev --workspace=@caas/web",
    "dev:api": "npm run dev --workspace=@caas/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "k8s:render": "kubectl kustomize k8s",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  }
}
